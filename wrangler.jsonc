// Déploiement du site statique via Cloudflare Workers (static assets).
// Le connecteur OAuth de l'admin a sa propre config dans decap-oauth-worker/.
{
  "name": "cabc-volley",
  // Le worker se place devant les assets pour tenir le brouillon hors des index
  // tant qu il n a pas remplace le site officiel. Voir worker.js.
  "main": "worker.js",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "kv_namespaces": [
    { "binding": "FFVB", "id": "c1573a51b06a4fb49a10df3ef3141d81" }
  ],
  // Toutes les heures, samedi et dimanche seulement : 48 declenchements par
  // semaine au lieu de 168. Les crons sont en UTC, ce qui couvre le samedi matin
  // jusqu au lundi 1 h ou 2 h du matin en heure francaise.
  "triggers": { "crons": ["0 * * * 6,0"] }
}
