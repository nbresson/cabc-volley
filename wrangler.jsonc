// Déploiement du site statique via Cloudflare Workers (static assets).
// Le connecteur OAuth de l'admin a sa propre config dans decap-oauth-worker/.
{
  "name": "cabc-volley",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
